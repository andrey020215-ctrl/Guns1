<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PegasusVipArsenal</AssemblyName>
  </PropertyGroup>
  <Target Name="RequireCsSharpApi" BeforeTargets="ResolveReferences" Condition="'$(CounterStrikeSharpApiPath)' == ''">
    <Error Text="Set -p:CounterStrikeSharpApiPath=/path/to/CounterStrikeSharp.API.dll matching your installed server" />
  </Target>
  <ItemGroup Condition="'$(CounterStrikeSharpApiPath)' != ''">
    <Reference Include="CounterStrikeSharp.API"><HintPath>$(CounterStrikeSharpApiPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
